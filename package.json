{
  "name": "caissepro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "prebuild:exe": "node -e \"require('fs').copyFileSync('public/caissepro-icon.svg','electron/caissepro-icon.svg')\"",
    "build:exe": "npm run build && electron-builder --win nsis && electron-builder --win portable"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@tauri-apps/api": "^2.9.1",
    "lucide-react": "^0.544.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.9.4",
    "recharts": "^3.2.1",
    "sql.js": "^1.13.0",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.caissepro.desktop",
    "productName": "CaissePro",
    "directories": {
      "output": "release"
    },
    "files": [
      "!**/*",
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "dist/**/*.wasm",
      "dist/sql-wasm.js"
    ],
    "compression": "normal",
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "CaissePro-${version}-Portable.exe",
      "requestExecutionLevel": "user"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "artifactName": "CaissePro-${version}-Setup.exe",
      "shortcutName": "CaissePro",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/cli": "^2.9.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "vite": "^6.3.6"
  }
}
